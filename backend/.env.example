# ── Transity - Bergen Real-Time Transit Backend ────────────────────────
# Python FastAPI service that aggregates live transit data for Bergen, Norway.

# External API that proxies transit / AIS / weather / traffic data.
API_BASE_URL=https://allemannsdata.com/wiki/api/v1/kilder

# Bergen city centre coordinates.
BERGEN_LAT=60.39299
BERGEN_LON=5.32415

# Search radii (km).
BUS_RADIUS=2.5
SHIP_RADIUS=4.5
TRAFFIC_RADIUS=8

# Record limits per source.
BUS_LIMIT=100
SHIP_LIMIT=100
TRAFFIC_LIMIT=40

# Cache TTLs (seconds).
BUS_CACHE_TTL=30
SHIP_CACHE_TTL=300
TRAFFIC_CACHE_TTL=900
WEATHER_CACHE_TTL=60
FEED_CACHE_TTL=15

# Server.
HOST=0.0.0.0
PORT=8000
